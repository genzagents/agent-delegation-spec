{
  "name": "@genzagents/adg",
  "version": "0.1.0",
  "description": "Agent Delegation Grant (ADG) v0.1 reference implementation: issue, countersign, present, verify, revoke. Zero dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "adg": "dist/cli.js" },
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": { ".": { "types": "./src/index.ts", "default": "./dist/index.js" } },
  "files": ["dist", "src", "examples", "grant.schema.json", "SPEC.md", "README.md", "LICENSE-CODE"],
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test 'tests/*.test.ts'",
    "example": "node src/cli.ts example examples"
  },
  "repository": { "type": "git", "url": "https://github.com/genzagents/agent-delegation-spec.git" },
  "keywords": ["agent", "delegation", "authorization", "ed25519", "http-message-signatures", "rfc9421", "did"]
}
